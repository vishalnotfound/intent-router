      "Apple": ["apple"], "Samsung": ["samsung"], "Dell": ["dell"], "HP": ["hp"], "Lenovo": ["lenovo"],
      "Asus": ["asus"], "Acer": ["acer"], "MSI": ["msi"], "Sony": ["sony"], "LG": ["lg"],
      "OnePlus": ["oneplus"], "Xiaomi": ["xiaomi", "redmi", "mi"], "Realme": ["realme"], "Oppo": ["oppo"],
      "Vivo": ["vivo"], "Google": ["google pixel"], "Nike": ["nike"], "Adidas": ["adidas"], "Puma": ["puma"],
      "boAt": ["boat headphones", "boat earbuds"], "JBL": ["jbl"], "Bose": ["bose"], "Logitech": ["logitech"], "Microsoft": ["microsoft"],
      "Canon": ["canon"], "Nikon": ["nikon"], "Whirlpool": ["whirlpool"], "Philips": ["philips"]
    },
    "color": {
