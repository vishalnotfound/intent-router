{
  "version": "1.0",
  "description": "E-commerce domain extension.",
  "intents": [
    {
      "id": "ecommerce.product_search",
      "label": "search for a product to buy",
      "action": "search",
      "target": "products",
      "domain": "ecommerce",
      "description": "Find products to buy matching a category, budget, brand, specs, use case or preferences.",
      "examples": [
        "Find a budget phone with a good camera",
        "show me running shoes under 3000 rupees",
        "I'm looking for noise cancelling headphones",
        "any good phones below 20k?",
        "I want to buy a washing machine with good ratings",
        "search for a 55 inch 4K TV",
        "I need a gift for my dad who likes cooking",
        "best budget smartwatch",
        "recommend a laptop for video editing",
        "show me black leather jackets in size M",
        "where can I buy a mechanical keyboard",
        "cheapest 1TB SSD available",
        "I'm shopping for a study table",
        "need a new mixer grinder for the kitchen",
        "looking to purchase a yoga mat",
        "find me a cotton kurta for summer",
        "stainless steel water bottle that keeps drinks cold"
      ],
      "negative_examples": [
        "compare the Dell XPS 13 and MacBook Air",
        "where is my order",
        "my laptop won't turn on",
        "find Python jobs in Noida"
      ],
      "parameters": [
        {"name": "product", "types": ["product"], "recommended": true},
        {"name": "brand", "types": ["brand"], "multiple": true},
        {"name": "budget", "types": ["money_constraint", "money"], "kind": "filter", "recommended": true},
        {"name": "use_case", "types": ["use_case"]},
        {"name": "price_preference", "types": ["price_preference"], "kind": "filter"},
        {"name": "sort", "types": ["sort"], "kind": "filter"},
        {"name": "rating", "types": ["rating"], "kind": "filter"},
        {"name": "color", "types": ["color"], "kind": "filter"},
        {"name": "size", "types": ["size"], "kind": "filter"},
        {"name": "specs", "types": ["quantity"], "multiple": true, "kind": "filter"},
        {"name": "requirements", "types": ["requirements"], "multiple": true}
      ],
      "side_effects": "read",
      "operation": "search_products"
    },
    {
      "id": "ecommerce.compare_products",
      "label": "compare products",
      "action": "compare",
      "target": "products",
      "domain": "ecommerce",
      "description": "Compare specific products or models on price, specs or quality before buying.",
      "examples": [
        "Compare the Galaxy S23 and iPhone 14",
        "which is better, Dell XPS 13 or MacBook Air?",
        "Samsung S24 vs OnePlus 12 camera comparison",
        "difference between Sony WH-1000XM5 and Bose QC45",
        "should I buy the iPad Air or the Galaxy Tab S9",
        "compare prices of these two laptops",
        "how does the Kindle Paperwhite compare with the Kobo Clara"
      ],
      "negative_examples": [
        "Compare Python and Java",
        "find a cheap laptop"
      ],
      "parameters": [
        {"name": "items", "types": ["comparison_items"], "multiple": true, "recommended": true},
        {"name": "criteria", "types": ["comparison_criteria"], "multiple": true},
        {"name": "product", "types": ["product"]}
      ],
      "side_effects": "read",
      "operation": "compare_products"
    },
    {
      "id": "ecommerce.order_status",
      "label": "check an order's status",
      "action": "retrieve",
      "target": "order",
      "domain": "ecommerce",
      "description": "Check the status, location or delivery date of an order or package that was already placed.",
      "examples": [
        "Where is my order?",
        "track order #A12345",
        "has my package shipped yet",
        "when will my headphones be delivered",
        "check the status of order 4567",
        "my parcel hasn't arrived",
        "is my order out for delivery?",
        "the tracking page hasn't updated in days"
      ],
      "negative_examples": [
        "cancel my order",
        "I want to buy headphones"
      ],
      "parameters": [
        {"name": "order_id", "types": ["identifier"], "recommended": true},
        {"name": "product", "types": ["product"]}
      ],
      "side_effects": "read",
      "operation": "get_order_status"
    },
    {
      "id": "ecommerce.cancel_or_return",
      "label": "cancel, return or refund an order",
      "action": "modify",
      "target": "order",
      "domain": "ecommerce",
      "description": "Cancel an order, return or exchange an item, or request a refund.",
      "examples": [
        "Cancel my order 12345",
        "I want to return these shoes",
        "how do I get a refund for a damaged product",
        "please cancel the laptop order I placed yesterday",
        "start a return for order #889",
        "I'd like to exchange this shirt for a bigger size",
        "stop my subscription from renewing",
        "I want to send back the dress I ordered",
        "the blender arrived broken, I need a replacement",
        "return the phone I bought last week"
      ],
      "negative_examples": [
        "where is my order",
        "buy new shoes"
      ],
      "parameters": [
        {"name": "request_type", "types": ["order_action"], "recommended": true},
        {"name": "order_id", "types": ["identifier"], "recommended": true},
        {"name": "product", "types": ["product"]}
      ],
      "side_effects": "destructive",
      "operation": "order_change_request"
    }
  ],
  "gazetteers": {
    "product": {
      "laptop": ["laptop", "notebook computer"],
