      "grey": ["grey", "gray"], "silver": ["silver"], "gold": ["gold", "golden"], "pink": ["pink"],
      "yellow": ["yellow"], "brown": ["brown"], "purple": ["purple"], "orange": ["orange"], "navy": ["navy", "navy blue"]
    },
    "order_action": {
