# Copy to .env and edit. Every setting is optional; defaults are shown.

# Embedding model. The alternative is BAAI/bge-small-en-v1.5 (needs its own thresholds).
ROUTER_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
# false = load from the local Hugging Face cache only (no network). Download once with
#   python scripts/download_models.py
ROUTER_ALLOW_MODEL_DOWNLOAD=false
# ROUTER_MODEL_CACHE_DIR=C:\models\hf
ROUTER_DEVICE=cpu
# Torch intra-op threads. Empty = min(4, cores/2). More threads made single requests slower.
# ROUTER_TORCH_THREADS=4

# Decision thresholds. Leave unset to use the per-model values in intent_router/data/thresholds.json.
# ROUTER_REJECT_THRESHOLD=0.35
# ROUTER_ACCEPT_THRESHOLD=0.5
# ROUTER_MARGIN_THRESHOLD=0.04

# Behaviour
ROUTER_MAX_MESSAGE_CHARS=2000
ROUTER_MAX_TASKS=4
ROUTER_ENABLE_MULTI_INTENT=true
ROUTER_DATE_ORDER=DMY

# Optional local LLM fallback for ambiguous/low-confidence cases (off by default).
# Download first: python scripts/download_models.py --fallback
ROUTER_FALLBACK=none
# ROUTER_FALLBACK=local_llm
# ROUTER_FALLBACK_MODEL=Qwen/Qwen2.5-0.5B-Instruct

# Optional NLI check for destructive/financial requests (off by default). It blocks
# requests such as "I no longer want to cancel my order" that the negation rules miss.
# Costs ~+330 MB RAM and ~65-100 ms on the requests it checks (cancel/return, bookings).
# Download first: python scripts/download_models.py --verifier
ROUTER_VERIFIER=none
# ROUTER_VERIFIER=nli
# ROUTER_VERIFIER_MODEL=cross-encoder/nli-deberta-v3-xsmall
# ROUTER_VERIFIER_CONTRADICTION=0.5
# ROUTER_VERIFIER_ENTAILMENT=0.5

# Logging. User message text is never logged unless ROUTER_LOG_MESSAGES=true.
ROUTER_LOG_LEVEL=INFO
ROUTER_LOG_MESSAGES=false
